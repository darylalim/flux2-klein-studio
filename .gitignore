# Environment
.venv/

# Secrets — mirror guard-paths.sh and tests/test_secrets.py; any committed
# .env.example/.sample/.template/.dist template stays tracked.
.env
.env.*
!.env.example
!.env.sample
!.env.template
!.env.dist
secrets.toml
*.pem

# Python
__pycache__/

# Tooling caches
.pytest_cache/
.ruff_cache/
.ty_cache/

# Claude Code (settings.json + hooks/ are tracked; personal overrides are not)
.claude/settings.local.json
.claude/.tests-pending

# macOS
.DS_Store
